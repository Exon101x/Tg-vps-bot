# ============================================================================
# vpsbot configuration - the A-to-Z .env template
#
#   cp .env.example .env && nano .env        # then fill in the 5 required vars
#   python deploy.py --check                 # validate what you filled in
#
# Rules the whole file follows:
#   * lines starting with # and blank lines are ignored; later lines win
#   * values are written bare (no quotes needed, even with spaces)
#   * real environment variables override this file (PaaS dashboards win)
#   * SECRET_KEY decrypts saved servers: back it up, never change it casually
#   * everything below the required block is optional and safe to leave as-is
# ============================================================================


# ---------------------------------------------------------------- REQUIRED (5)
# The bot refuses to start without these.

# --- Telegram app credentials (https://my.telegram.org -> API development tools)
# API_ID: the numeric id shown on that page.
API_ID=
# API_HASH: the 32-character hex string next to it.
API_HASH=

# --- Bot token (@BotFather -> /newbot, or /token for an existing bot)
# Format: 123456789:AAE...  Keep it secret: whoever has it IS the bot.
BOT_TOKEN=

# --- Encryption key for saved servers (passwords, private keys) in the database.
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                (any random 16+ character string also works)
# Losing it makes saved servers unreadable; changing it makes them garbage.
# Back it up somewhere safe, and never commit the real .env to git.
SECRET_KEY=

# --- Who may use the bot: comma-separated numeric Telegram user ids.
# Find yours: send /start to @userinfobot (or @userinfobot in Telegram search).
# Leave empty on a private bot only if you also set DEV_ID/ADMINS below - an
# empty ALLOWED_USERS with no admins means nobody can do anything.
ALLOWED_USERS=


# ---------------------------------------------------------------- DATABASE
# Default: SQLite file (bot.db) next to the bot - fine for one machine.
# For anything bigger / any PaaS, pick ONE:
#   postgresql://user:pass@host:5432/dbname     (postgres:// works too)
#   mysql://user:pass@host:3306/dbname          (MySQL / MariaDB)
#   mongodb://user:pass@host:27017/dbname       (mongodb+srv://... for Atlas)
DATABASE_URL=
# Only used with mongodb:// URLs without a database in the path:
#MONGO_DB=vpsbot
# Path/filename of the SQLite file (only when DATABASE_URL is empty):
#BOT_DB=bot.db
# Seconds to retry the connection while the database is still starting up
# (docker compose / PaaS addons): 10 tries, 3s apart. 0 = fail at once.
DB_CONNECT_RETRIES=10


# ---------------------------------------------------------------- ADMIN & COMMUNITY
# Your own Telegram id: admin panel access + exempt from FORCE_SUB.
#DEV_ID=123456789
# Extra admins on top of DEV_ID, comma-separated.
#ADMINS=123456789,987654321
# Your channel (with or without @): shown as the developer credit in /about
# and the Mini App footer.
#DEV_CHANNEL=yourchannel
# Channel users must join before the bot answers them. Add the bot as ADMIN
# in that channel so it can check membership.
#FORCE_SUB=yourchannel


# ---------------------------------------------------------------- WEB / MINI APP
# The bot's public HTTPS address (https://bot.example.com). This is what
# enables the Mini App: the /app button, the menu button and webhook callbacks
# all point here. Leave empty to run the bot without the web app.
#WEBAPP_URL=https://bot.example.com
# Extra origins allowed to call the API (comma list). The WEBAPP_URL origin is
# always allowed; set this when the Mini App is hosted elsewhere (Netlify,
# Cloudflare Pages, ...) or on custom domains / preview deployments.
#   Split setup:  ALLOWED_ORIGINS=https://your-app.netlify.app
#ALLOWED_ORIGINS=
# Mini App API requests per minute per user (token bucket, min 10).
WEB_RATE=90
# Size cap in MB for files uploaded through the Mini App (0 = no limit).
# Uploads are chunked and resumable; they stream through the bot, so leave
# disk headroom on its host.
WEB_MAX_MB=4096

# ---------------------------------------------------------------- HTTP & HEALTH
# The port the bot's HTTP server (health endpoint + web app) listens on.
# PaaS platforms set PORT themselves - only set it yourself on your own box.
#PORT=8080
# Same thing for hosts that set neither: use this if your platform expects a
# specific port but does not inject PORT.
#HEALTH_PORT=8080
# What the health endpoint binds to. 0.0.0.0 = all interfaces (PaaS default);
# use 127.0.0.1 when a reverse proxy (nginx/Caddy) on the same box fronts it.
HEALTH_BIND=0.0.0.0
# Ping our own public URL every KEEP_ALIVE_INTERVAL seconds so free web
# services (Render free tier) don't fall asleep. 1 = on, empty = off.
#KEEP_ALIVE=1
#KEEP_ALIVE_URL=https://bot.example.com   # defaults to RENDER_EXTERNAL_URL on Render
#KEEP_ALIVE_INTERVAL=600                   # min 1s; 600 = every 10 minutes


# ---------------------------------------------------------------- VPS HOSTING (selling plans with included VPSes)
# See docs/CONFIG.md for the full walkthrough. Without VPS_NODE_HOST the VPS
# plans still sell and activate, but instances wait and the admin panel shows
# a warning.
# The host node = the machine the included VPSes are created on (needs root
# or passwordless sudo).
#VPS_NODE_HOST=203.0.113.9        # required to provision instances
#VPS_NODE_PORT=22                 # min 1, max 65535
#VPS_NODE_USER=root               # anything else gets "sudo -n " in front of every command
#VPS_NODE_PASS=                   # node password, or point VPS_NODE_KEY at a private key file
#VPS_NODE_KEY=/path/to/key        # (takes precedence over the password)
# What buyers connect to (defaults to VPS_NODE_HOST; set if the node sits behind NAT).
#VPS_PUBLIC_HOST=
#VPS_SSH_PORT=22                  # the SSH port of the created instances themselves
# Commands run on the node to create/delete an instance user. Placeholders:
#   {user} {pass} {cpu} {ram} {disk} - credentials are alnum-only (no injection).
# Override for LXC / Docker / Proxmox provisioning.
#VPS_PROVISION_CMD=useradd -m -s /bin/bash {user} && echo '{user}:{pass}' | chpasswd && (setquota -u {user} {disk}G {disk}G 0 0 / 2>/dev/null || true)
#VPS_DEPROVISION_CMD=userdel -rf {user}
# Seconds between VPS health checks (min 30).
MONITOR_INTERVAL=300
# % full/used that triggers an alert to the admins (1-100).
DISK_ALERT=90
MEM_ALERT=90


# ---------------------------------------------------------------- SUBSCRIPTIONS & PAYMENTS
# --- Plans (see docs/CONFIG.md for the default catalog: free/pro/vps1/vps2)
# What prices are shown in (USD, INR, ...).
#SUBSCRIPTION_CURRENCY=USD
# JSON array replacing the default catalog. Fields: key, name, price, days,
#   max_servers (-1 = unlimited), vps_slots, vps_cpu, vps_ram (MB),
#   vps_disk (GB), tag, desc, order.
#SUBSCRIPTION_PLANS=
# Shown at checkout; supports {amount} {currency} {plan} {days}.
# Default: pay however the owner accepts, then /paid <reference>.
#PAYMENT_INFO=

# --- Payment gateways (all optional). Without any, the buyer sends
#     /paid <reference> and you approve by hand. With a gateway set up,
#     paying activates the plan AUTOMATICALLY.
#     Quick setup:  python3 setup_gateway.py   (guided wizard: validates,
#     live-tests and writes these; --check diagnoses a running setup,
#     --write KEY=V batch-writes, --gen-secret, --qr)

# UPI direct - a upi://pay QR + app button with YOUR UPI id (manual /paid confirm):
#UPI_VPA=yourname@okicici
#UPI_NAME=Your Name

# UPI Gateway - your self-hosted multi-merchant UPI gateway
# (github.com/Exon101x/upi-gateway): the buyer gets its checkout page
# (dynamic QR + UPI app deep links); its verified webhook below auto-approves
# the order. INR prices. Credentials from the gateway's Dashboard ->
# API & Webhooks; point its webhook URL at {WEBAPP_URL}/pay/upigw/cb.
#UPIGW_URL=https://pay.yourdomain.com
#UPIGW_API_KEY=            # the merchant API key (X-Api-Key)
#UPIGW_API_SECRET=         # the merchant API secret (X-Api-Secret)
#UPIGW_WEBHOOK_SECRET=     # the Live webhook signing secret (X-Signature: t=...,v1=...)
#UPIGW_MAX_SKEW=300        # seconds a webhook timestamp may drift (30-3600)

# Crypto via CryptAPI (no signup; paid out to YOUR OWN wallets; 100+ coins;
# cryptapi.io). One line per coin = one more coin buyers can pay with:
#CRYPTAPI_BTC_ADDR=bc1...
#CRYPTAPI_TRC20_USDT_ADDR=T...       # tokens: <CHAIN>_<TOKEN> (TRC20_USDT -> trc20/usdt)
#CRYPTAPI_TOLERANCE=1                # % underpayment still accepted (0-10)
#CRYPTAPI_CONFIRMATIONS=1            # blockchain confirmations before activation (1-64)
#CRYPTAPI_API_KEY=                   # BlockBee pro key (optional; switches to api.blockbee.io)
#CRYPTAPI_BASE=https://api.blockbee.io   # only with a BlockBee key: the API base to use
# Note: CryptAPI only creates payment addresses for callback domains you
# verify once at https://cryptapi.io (DNS TXT / HTTPS file) - verify the
# WEBAPP_URL domain.


# ---------------------------------------------------------------- SESSION & SINGLE-INSTANCE
# Where the Telegram session file lives (also snapshotted into the database).
SESSION_DIR=.
# Seconds between session snapshots (min 10).
SESSION_SYNC_INTERVAL=300
# Seconds before an abandoned single-instance lock is taken over (min 5).
LOCK_TTL=60
# Ignore the stored session and log in again with BOT_TOKEN (one-shot fix
# for a corrupted session, e.g. after a token reset at BotFather).
#RESET_SESSION=1
# Skip the single-instance lock. Only if you are sure exactly one copy runs
# (the lock prevents two bots sharing one session - Telegram logs one out).
#DISABLE_LOCK=1


# ---------------------------------------------------------------- LOGGING
# DEBUG | INFO | WARNING | ERROR. INFO is the right level for production.
LOG_LEVEL=INFO


# ---------------------------------------------------------------- TRANSFER TUNING
# Size cap in MB for /fetch downloads streamed by the bot (0 = no limit).
MAX_FETCH_MB=0
# Largest single file /get sends in MB; bigger files go out as .001 .002 ...
# volumes. Telegram allows 2 GB per bot file - 1900 leaves header room.
TG_MAX_MB=1900
# Attempts per upload before it is marked failed (min 1).
MAX_RETRIES=5

# Speed: the bot detects CPU cores and RAM and picks a profile; set
# PERFORMANCE to force one.  auto | light (small hosts) | balanced | turbo
# (4+ cores, 3+ GB RAM).  /perf shows the live values.
PERFORMANCE=auto
# Individual values override the profile (shown by /perf):
#TG_PARALLEL=16         # simultaneous download windows from Telegram
#TG_WINDOW_MB=16        # MB per window; memory use is about TG_PARALLEL x TG_WINDOW_MB
#SFTP_WINDOW_MB=32      # SFTP window: bigger is faster over high-latency links
#FTP_BLOCK_KB=1024      # FTP send block size
#PARALLEL_PER_SERVER=2  # simultaneous uploads per server (profile default: 1, turbo: 2)


# ---------------------------------------------------------------- STATIC HOST OF THE MINI APP (optional split setup)
# NOT read by the bot at runtime. Used by scripts/build_webapp.py to inject
# the API base into the static build, and by netlify.toml on Netlify's build
# machines. Set it to the bot's public HTTPS address (same as WEBAPP_URL)
# when you deploy webapp-dist/ on Netlify / Cloudflare Pages / Vercel:
#   Netlify: Site settings -> Environment variables -> BOT_API_URL
# Don't have that address yet? docs/DEPLOY.md, "From a bare VPS to
# https://bot.example.com" builds it from scratch (domain, DNS, TLS proxy,
# HEALTH_PORT wiring) - same address WEBAPP_URL above needs.
#BOT_API_URL=https://bot.example.com

# ---- required
API_ID=
API_HASH=
BOT_TOKEN=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Any random string of 16+ characters also works. Keep it safe: it encrypts saved passwords/keys.
# Losing or changing it makes them unreadable.
SECRET_KEY=
# comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USERS=

# ---- database (default: SQLite file next to the bot)
# sqlite:///bot.db
# postgresql://user:pass@host:5432/dbname      (postgres:// works too)
# mysql://user:pass@host:3306/dbname           (MySQL / MariaDB)
# mongodb://user:pass@host:27017/dbname        (or mongodb+srv://... for Atlas)
DATABASE_URL=

# ---- admin & community (all optional)
# DEV_ID=123456789           # your Telegram id (send /start to @userinfobot to see yours):
#                            #   admin panel access + exempt from FORCE_SUB
# ADMINS=123456789,987654321 # extra admins; DEV_ID is an admin automatically
# DEV_CHANNEL=yourchannel    # your channel: shown as the developer credit (/about, Mini App footer)
# FORCE_SUB=yourchannel      # users must join this channel before they can use the bot.
#                            #   Add the bot as ADMIN in the channel so it can check members.
# WEB_RATE=90                # Mini App API requests per minute per user (rate limit)

# ---- subscriptions & VPS hosting (sell plans with included VPSes; see docs/CONFIG.md)
# SUBSCRIPTION_CURRENCY=USD  # what prices are shown in
# SUBSCRIPTION_PLANS=        # JSON array to replace the default catalog (free/pro/vps1/vps2).
#                            #   Fields: key, name, price, days, max_servers (-1 = unlimited),
#                            #   vps_slots, vps_cpu, vps_ram (MB), vps_disk (GB), tag, desc, order
# PAYMENT_INFO=              # shown at checkout; supports {amount} {currency} {plan} {days}.
#                            #   Default: pay however the owner accepts, then /paid <reference>.
# The host node = the machine the included VPSes are created on (needs root or passwordless sudo):
# VPS_NODE_HOST=203.0.113.9  # required to provision; without it VPS plans still activate, the
#                            #   admin just sees a warning and instances wait
# VPS_NODE_PORT=22
# VPS_NODE_USER=root         # anything else gets "sudo -n " in front of every command
# VPS_NODE_PASS=             # node password, or point VPS_NODE_KEY at a private key file instead
# VPS_NODE_KEY=/path/to/key
# VPS_PUBLIC_HOST=           # what buyers connect to (defaults to VPS_NODE_HOST; set behind NAT)
# VPS_SSH_PORT=22            # the SSH port of the created instances
# VPS_PROVISION_CMD=useradd -m -s /bin/bash {user} && echo '{user}:{pass}' | chpasswd && (setquota -u {user} {disk}G {disk}G 0 0 / 2>/dev/null || true)
#                            # placeholders: {user} {pass} {cpu} {ram} {disk} - override for LXC /
#                            # Docker / Proxmox provisioning; credentials are alnum-only (no injection)
# VPS_DEPROVISION_CMD=userdel -rf {user}

# ---- hosting
SESSION_DIR=.                # where the Telegram session file lives (also snapshotted into the database)
SESSION_SYNC_INTERVAL=300    # seconds between session snapshots
# PORT=8080                  # PaaS platforms set this; the bot then answers HTTP health checks on it
# HEALTH_PORT=8080           # same, for hosts that don't set PORT
# HEALTH_BIND=0.0.0.0        # what the health endpoint binds to; use 127.0.0.1 on your own VPS
# WEBAPP_URL=https://your-app.onrender.com   # the bot's public HTTPS address: enables the Mini App (/app button + menu button)
# WEB_MAX_MB=4096            # size cap in MB for files uploaded through the Mini App (0 = no limit)
# KEEP_ALIVE=1               # ping our own public URL every 10 min so free web services (Render) don't fall asleep
# KEEP_ALIVE_URL=https://your-app.onrender.com   # defaults to RENDER_EXTERNAL_URL on Render
# RESET_SESSION=1            # ignore the stored session and log in again with BOT_TOKEN
# LOCK_TTL=60                # seconds before an abandoned single-instance lock is taken over
# DISABLE_LOCK=1             # skip the single-instance lock (only if you are sure one copy runs)
DB_CONNECT_RETRIES=10        # wait for a database that is still starting (3s apart)
LOG_LEVEL=INFO

# ---- tuning
MONITOR_INTERVAL=300     # seconds between VPS health checks
DISK_ALERT=90            # % disk full that triggers an alert
MEM_ALERT=90             # % memory used that triggers an alert
MAX_FETCH_MB=0           # size cap in MB for /fetch downloads streamed by the bot (0 = no limit)
TG_MAX_MB=1900           # largest single file /get sends; bigger files go out as .001 .002 ... volumes

# ---- speed: the bot detects CPU cores and RAM and picks a profile; set PERFORMANCE to force one
PERFORMANCE=auto         # auto | light (small hosts) | balanced | turbo (4+ cores, 3+ GB RAM)
# Individual values override the profile (shown by /perf):
# TG_PARALLEL=16         # simultaneous download windows from Telegram
# TG_WINDOW_MB=16        # MB per window; memory use is about TG_PARALLEL x TG_WINDOW_MB
# SFTP_WINDOW_MB=32      # SFTP window: bigger is faster over high-latency links
# FTP_BLOCK_KB=1024      # FTP send block size
MAX_RETRIES=5            # attempts per upload before it is marked failed
# PARALLEL_PER_SERVER=2  # simultaneous uploads per server (profile default: 1, turbo: 2)
